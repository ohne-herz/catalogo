# --- Servidor ---
PORT=3000
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# --- Credenciales del admin (mantenedor) ---
# Genera el hash con: node -e "console.log(require('bcryptjs').hashSync('TU_PASSWORD', 10))"
ADMIN_USER=admin
ADMIN_PASS_HASH=$2a$10$reemplazaEsteHashGeneradoConBcrypt

# --- SMTP para el envío de correos ---
# Ejemplo con Gmail (requiere "contraseña de aplicación", no la contraseña normal)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tu-cuenta@gmail.com
SMTP_PASS=tu-contraseña-de-aplicacion

# Email por defecto al que llegan los leads (editable luego desde el mantenedor)
DEFAULT_TARGET_EMAIL=ventas@tuempresa.cl
